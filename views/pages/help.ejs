<% layout("/layouts/boilerplate") %>

<main class="static-page py-4 py-md-5">
    <div class="container" style="max-width: 58rem;">
        <div class="mb-3">
            <%- include("../includes/backButton.ejs", { fallback: "/listings", label: "Back to listings" }) %>
        </div>

        <header class="static-page-header mb-4 text-center">
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold mb-2">Support & Assistance</span>
            <h1 class="display-6 fw-bold text-dark">Help & Frequently Asked Questions</h1>
            <p class="text-muted fs-5 col-lg-8 mx-auto">
                Find answers to common questions about booking stays, listing homes, and managing your account.
            </p>
        </header>

        <div class="accordion accordion-flush card shadow-sm border-0 rounded-4 overflow-hidden mb-4 p-3 p-md-4" id="faqAccordion">
            <!-- 1. Booking -->
            <div class="accordion-item border-bottom mb-2">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button collapsed fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        <i class="fa-solid fa-calendar-check text-danger me-2"></i> How do I request a booking?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-secondary pt-1 pb-3">
                        Visit any listing page, choose your desired check-in and check-out dates in the reservation panel, enter an optional message for your host, and submit the booking request. You can check the current status of all your requests at any time under <a href="/bookings" class="text-danger fw-semibold">My Bookings</a>.
                    </div>
                </div>
            </div>

            <!-- 2. Pricing & Taxes -->
            <div class="accordion-item border-bottom mb-2">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        <i class="fa-solid fa-calculator text-danger me-2"></i> How are prices and taxes calculated?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-secondary pt-1 pb-3">
                        Each listing displays its base nightly rate in INR (&#8377;). On the listings page, you can use the "Display total after taxes" switch in the filter bar to preview prices with applicable taxes (+18% GST) directly on the cards.
                    </div>
                </div>
            </div>

            <!-- 3. Categories & Search -->
            <div class="accordion-item border-bottom mb-2">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        <i class="fa-solid fa-filter text-danger me-2"></i> How do category filters and search work?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-secondary pt-1 pb-3">
                        You can search destinations using the search bar in the top navigation or filter by categories like City Stays, Mountain Stays, Nature Retreats, Heritage Stays, and Beach & Island. You can click "Clear filters" at any time to reset and view all available listings.
                    </div>
                </div>
            </div>

            <!-- 4. Becoming a Host -->
            <div class="accordion-item border-bottom mb-2">
                <h2 class="accordion-header" id="headingFour">
                    <button class="accordion-button collapsed fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        <i class="fa-solid fa-house-chimney text-danger me-2"></i> How do I list my property as a host?
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-secondary pt-1 pb-3">
                        First, complete host onboarding via the <a href="/become-a-host" class="text-danger fw-semibold">Become a Host</a> page with your contact details. Once onboarded, click "Airbnb your home" to create listings with photos, location, nightly rate, and category. You can manage incoming guest requests in your <a href="/host/bookings" class="text-danger fw-semibold">Hosting Requests</a> dashboard.
                    </div>
                </div>
            </div>

            <!-- 5. Reviews -->
            <div class="accordion-item border-bottom mb-2">
                <h2 class="accordion-header" id="headingFive">
                    <button class="accordion-button collapsed fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                        <i class="fa-solid fa-star text-danger me-2"></i> How do ratings and reviews work?
                    </button>
                </h2>
                <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-secondary pt-1 pb-3">
                        Registered users can leave a 1-to-5 star rating and comment on any listing details page. You can also delete your own reviews if you wish to remove them.
                    </div>
                </div>
            </div>

            <!-- 6. Profile & Privacy -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingSix">
                    <button class="accordion-button collapsed fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
                        <i class="fa-solid fa-user-shield text-danger me-2"></i> How can I update my profile and name?
                    </button>
                </h2>
                <div id="collapseSix" class="accordion-collapse collapse" aria-labelledby="headingSix" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-secondary pt-1 pb-3">
                        Visit your <a href="/profile/edit" class="text-danger fw-semibold">Edit Profile</a> page to update your Public Display Name, username, or change your account password. Your host phone number is kept private by default and is never exposed publicly on listing cards.
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-light border-0 rounded-4 p-4 text-center">
            <h3 class="h5 fw-bold text-dark mb-2">Still need help?</h3>
            <p class="text-muted small mb-3">Our team is available to assist you with any questions or issues.</p>
            <div>
                <a href="/contact" class="btn btn-outline-danger rounded-pill px-4">Contact Support</a>
            </div>
        </div>
    </div>
</main>
