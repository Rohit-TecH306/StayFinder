<%layout("/layouts/boilerplate")%>
    <div class="row mt-3 mb-5">
        <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
            <div class="mb-3">
                <%- include("../includes/backButton.ejs", { fallback: "/listings", label: "Back to listings" }) %>
            </div>

            <!-- 1. LISTING INFORMATION SECTION -->
            <div class="listing-show-header mb-3">
                <h2 class="listing-show-title">
                    <%= listing.title %>
                </h2>
                <div class="listing-show-subheaders">
                    <span class="listing-badge"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                        <%= listing.location %> &nbsp;|&nbsp; <i class="fa-solid fa-globe" aria-hidden="true"></i>
                            <%= listing.country %>
                    </span>
                    <span class="listing-badge host-badge"><i class="fa-regular fa-circle-user" aria-hidden="true"></i>
                        Hosted by <%= (listing.owner && (listing.owner.displayName || listing.owner.username)) ? (listing.owner.displayName || listing.owner.username) : "Host" %>
                    </span>
                </div>
            </div>

            <div class="show-card listing-hero-card mb-4">
                <% if (listing.image && listing.image.url) { %>
                    <img src="<%= listing.image.url %>" class="card-img-top show-img listing-hero-img"
                        alt="<%= listing.title %>">
                    <% } else { %>
                        <div class="card-img-top show-img listing-image-fallback" role="img"
                            aria-label="No image available for <%= listing.title %>">
                            No image available
                        </div>
                        <% } %>
                            <div class="card-body listing-hero-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="listing-hero-price">
                                        <span class="price-amount">&#8377;<%= listing.price.toLocaleString("en-IN") %>
                                                </span>
                                        <span class="price-period">/ night</span>
                                    </div>
                                </div>
                                <p class="listing-hero-description">
                                    <%= listing.description %>
                                </p>

                                <% if(currentUser && listing.owner && listing.owner._id &&
                                    listing.owner._id.equals(currentUser._id)) { %>
                                    <div class="owner-actions-bar mt-3 pt-3 border-top">
                                        <a href="/listings/<%= listing._id %>/edit"
                                            class="btn btn-dark edit-btn px-4"><i
                                                class="fa-regular fa-pen-to-square me-1" aria-hidden="true"></i> Edit
                                            Listing</a>
                                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
                                            class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger px-4 ms-2"><i
                                                    class="fa-regular fa-trash-can me-1" aria-hidden="true"></i> Delete
                                                Listing</button>
                                        </form>
                                    </div>
                                    <% } %>
                            </div>
            </div>

            <!-- 2. REQUEST TO BOOK SECTION -->
            <div class="booking-section-wrapper mb-4">
                <% if (!currentUser) { %>
                    <div class="card p-4 text-center border-0 shadow-sm rounded-4">
                        <h4 class="fw-bold mb-2">Request to Book</h4>
                        <p class="text-muted mb-3">Please log in to check availability and request this stay.</p>
                        <div>
                            <a href="/login" class="btn btn-danger px-4 fw-bold">Log In to Book</a>
                        </div>
                    </div>
                    <% } else if (listing.owner && listing.owner._id && listing.owner._id.equals(currentUser._id)) { %>
                        <div class="card p-4 text-center border-0 shadow-sm rounded-4">
                            <h4 class="fw-bold mb-2">Request to Book</h4>
                            <p class="text-muted mb-0"><i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>
                                You cannot book your own listing.</p>
                        </div>
                        <% } else { %>
                            <section class="booking-request-panel">
                                <header class="booking-request-header">
                                    <div>
                                        <p class="booking-request-kicker">Stay request</p>
                                        <h4>Request to book</h4>
                                    </div>
                                    <div class="booking-request-price">
                                        <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong>
                                        <span>/ night</span>
                                    </div>
                                </header>
                                <p class="booking-message-help">Choose dates to see an availability estimate. A request is not a guarantee of availability or a payment.</p>
                                <form action="/listings/<%= listing._id %>/bookings" method="POST"
                                    class="needs-validation" data-booking-form
                                    data-preview-url="/listings/<%= listing._id %>/bookings/preview" novalidate>
                                    <div class="row">
                                        <div class="mb-3 col-md-6">
                                            <label for="checkIn" class="form-label booking-field-label">Check-in</label>
                                            <input type="date" id="checkIn" name="booking[checkIn]"
                                                class="form-control booking-date-input" required>
                                            <div class="invalid-feedback">Choose a check-in date.</div>
                                        </div>
                                        <div class="mb-3 col-md-6">
                                            <label for="checkOut"
                                                class="form-label booking-field-label">Check-out</label>
                                            <input type="date" id="checkOut" name="booking[checkOut]"
                                                class="form-control booking-date-input" required>
                                            <div class="invalid-feedback">Choose a check-out date.</div>
                                        </div>
                                    </div>
                                    <section id="bookingPreview" class="booking-summary booking-summary-idle"
                                        role="status" aria-live="polite">
                                        <div class="booking-summary-header">
                                            <span id="bookingPreviewIcon" class="booking-summary-icon"
                                                aria-hidden="true"><i class="fa-regular fa-calendar"></i></span>
                                            <div>
                                                <p class="booking-summary-title">Booking Summary</p>
                                                <p id="bookingPreviewMessage" class="booking-summary-message">Select
                                                    your check-in and check-out dates to see availability and estimated
                                                    total.</p>
                                            </div>
                                        </div>
                                        <div id="bookingPreviewDetails" class="booking-summary-details" hidden>
                                            <div class="booking-summary-availability"><i
                                                    class="fa-solid fa-circle-check" aria-hidden="true"></i>Available
                                            </div>
                                            <div class="booking-summary-main">
                                                <strong id="bookingPreviewNights"></strong>
                                                <span id="bookingPreviewBreakdown"></span>
                                            </div>
                                            <div class="booking-summary-total">
                                                <span>Estimated total</span>
                                                <strong id="bookingPreviewTotal"></strong>
                                            </div>
                                        </div>
                                    </section>
                                    <div class="mb-3">
                                        <label for="guestMessage" class="form-label booking-field-label">Message for the
                                            host</label>
                                        <p id="guestMessageHelp" class="booking-message-help">Optional - tell the host
                                            anything they should know.</p>
                                        <textarea id="guestMessage" name="booking[guestMessage]"
                                            class="form-control booking-message-input" maxlength="500" rows="3"
                                            aria-describedby="guestMessageHelp"></textarea>
                                    </div>
                                    <button type="submit" class="btn booking-submit-button" data-booking-submit>
                                        <i class="fa-regular fa-calendar-check" data-booking-submit-icon
                                            aria-hidden="true"></i>
                                        <span data-booking-submit-label>Send Booking Request</span>
                                    </button>
                                </form>
                                <script>
                                    const bookingForm = document.querySelector("[data-booking-form]");
                                    const bookingPreview = document.getElementById("bookingPreview");
                                    const bookingPreviewIcon = document.getElementById("bookingPreviewIcon");
                                    const bookingPreviewMessage = document.getElementById("bookingPreviewMessage");
                                    const bookingPreviewDetails = document.getElementById("bookingPreviewDetails");
                                    const bookingPreviewNights = document.getElementById("bookingPreviewNights");
                                    const bookingPreviewBreakdown = document.getElementById("bookingPreviewBreakdown");
                                    const bookingPreviewTotal = document.getElementById("bookingPreviewTotal");
                                    let previewTimer;
                                    let previewRequestId = 0;

                                    const setBookingPreviewState = (state, message) => {
                                        bookingPreview.className = `booking-summary booking-summary-${state}`;
                                        bookingPreviewMessage.textContent = message;
                                        bookingPreviewDetails.hidden = state !== "available";
                                        bookingPreviewIcon.innerHTML = state === "loading"
                                            ? '<span class="booking-summary-spinner" aria-label="Loading"></span>'
                                            : `<i class="fa-regular ${state === "available" ? "fa-circle-check" : "fa-calendar"}" aria-hidden="true"></i>`;
                                    };

                                    const formatBookingCurrency = (amountPaise, currency) => new Intl.NumberFormat("en-IN", {
                                        style: "currency",
                                        currency,
                                        maximumFractionDigits: 0,
                                    }).format(amountPaise / 100);

                                    const updateBookingPreview = async () => {
                                        const checkIn = document.getElementById("checkIn").value;
                                        const checkOut = document.getElementById("checkOut").value;
                                        const requestId = ++previewRequestId;

                                        if (!checkIn || !checkOut) {
                                            setBookingPreviewState("idle", "Select your check-in and check-out dates to see availability and estimated total.");
                                            return;
                                        }

                                        if (checkOut <= checkIn) {
                                            setBookingPreviewState("invalid", "Check-out must be after check-in.");
                                            return;
                                        }

                                        setBookingPreviewState("loading", "Checking availability...");
                                        const params = new URLSearchParams({ checkIn, checkOut });

                                        try {
                                            const response = await fetch(`${bookingForm.dataset.previewUrl}?${params}`);
                                            const result = await response.json();
                                            if (requestId !== previewRequestId) return;
                                            if (!response.ok || result.available === false) {
                                                setBookingPreviewState("unavailable", "These dates are unavailable. Please choose different dates.");
                                                return;
                                            }

                                            bookingPreviewNights.textContent = `${result.nights} night${result.nights === 1 ? "" : "s"}`;
                                            bookingPreviewBreakdown.textContent = `${formatBookingCurrency(result.pricePerNightPaise, result.currency)} × ${result.nights} night${result.nights === 1 ? "" : "s"}`;
                                            bookingPreviewTotal.textContent = formatBookingCurrency(result.totalAmountPaise, result.currency);
                                            setBookingPreviewState("available", "Your selected dates are available.");
                                        } catch (error) {
                                            if (requestId === previewRequestId) {
                                                setBookingPreviewState("error", "We couldn't check availability right now. Please try again.");
                                            }
                                        }
                                    };

                                    bookingForm.querySelectorAll("#checkIn, #checkOut").forEach((field) => {
                                        field.addEventListener("change", () => {
                                            clearTimeout(previewTimer);
                                            previewTimer = setTimeout(updateBookingPreview, 250);
                                        });
                                    });

                                    bookingForm.addEventListener("submit", (e) => {
                                        if (!bookingForm.checkValidity()) return;
                                        if (bookingForm.dataset.submitting === "true") {
                                            e.preventDefault();
                                            return;
                                        }

                                        bookingForm.dataset.submitting = "true";
                                        const submitButton = bookingForm.querySelector("[data-booking-submit]");
                                        const submitLabel = bookingForm.querySelector("[data-booking-submit-label]");
                                        const submitIcon = bookingForm.querySelector("[data-booking-submit-icon]");

                                        if (submitButton) {
                                            submitButton.disabled = true;
                                            submitButton.setAttribute("aria-busy", "true");
                                        }
                                        if (submitLabel) {
                                            submitLabel.textContent = "Sending Request...";
                                        }
                                        if (submitIcon) {
                                            submitIcon.className = "booking-submit-spinner";
                                        }
                                    });
                                </script>
                            </section>
                            <% } %>
            </div>

            <!-- 3. REVIEWS & LEAVE REVIEW SECTION -->
            <div class="reviews-section-wrapper mb-4">
                <% if(currentUser){ %>
                    <div class="review-form-card mb-4">
                        <div class="review-form-header mb-3">
                            <h4 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square text-danger me-2"
                                    aria-hidden="true"></i>Leave a Review</h4>
                            <p class="text-muted small mb-0">Share your experience to help future guests.</p>
                        </div>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation"
                            novalidate>
                            <div class="mb-3">
                                <label for="rating" class="form-label booking-field-label">Rating</label>
                                <fieldset class="starability-slot">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                        value="0" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>

                            <div class="mb-3">
                                <label for="comments" class="form-label booking-field-label">Comments</label>
                                <textarea name="review[comment]" id="comments" cols="30" rows="3"
                                    class="form-control review-textarea" placeholder="Write your feedback here..."
                                    required></textarea>
                                <div class="invalid-feedback">Please add some comments for your review.</div>
                            </div>

                            <button class="btn btn-dark review-submit-btn"><i class="fa-regular fa-paper-plane me-1"
                                    aria-hidden="true"></i> Submit Review</button>
                        </form>
                    </div>
                    <% } %>

                        <% if (listing.reviews && listing.reviews.length> 0) { %>
                            <div class="reviews-list-container">
                                <h4 class="fw-bold mb-3 section-heading"><i
                                        class="fa-solid fa-comments me-2 text-danger" aria-hidden="true"></i>All Reviews
                                    (<%= listing.reviews.length %>)</h4>
                                <div class="row g-3">
                                    <% for (let review of listing.reviews) { %>
                                        <div class="col-12 col-md-6">
                                            <div class="card h-100 review-card">
                                                <div class="card-body d-flex flex-column justify-content-between">
                                                    <div>
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="review-avatar me-2" aria-hidden="true">
                                                                <i class="fa-solid fa-circle-user"></i>
                                                            </div>
                                                            <div>
                                                                <h6 class="card-title mb-0 fw-bold">@<%= review.author ?
                                                                        review.author.username : "guest" %>
                                                                </h6>
                                                            </div>
                                                        </div>
                                                        <p class="starability-result mb-2"
                                                            data-rating="<%= review.rating %>"></p>
                                                        <p class="card-text review-text">
                                                            <%= review.comment %>
                                                        </p>
                                                    </div>
                                                    <% if (currentUser && review.author &&
                                                        (review.author._id.equals(currentUser._id) || (listing.owner &&
                                                        listing.owner._id.equals(currentUser._id)))) { %>
                                                        <form class="mt-3 text-end" method="POST"
                                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                            <button
                                                                class="btn btn-sm btn-outline-danger review-delete-btn"><i
                                                                    class="fa-regular fa-trash-can me-1"
                                                                    aria-hidden="true"></i>Delete</button>
                                                        </form>
                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                            <% } %>
            </div>

            <!-- 4. LOCATION / MAP SECTION -->
            <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length===2) { %>
                <div class="listing-map-card mb-4">
                    <div class="map-card-header mb-3">
                        <h4 class="fw-bold mb-1"><i class="fa-solid fa-map-location-dot text-danger me-2"
                                aria-hidden="true"></i>Where you'll be</h4>
                        <p class="text-muted mb-0" style="font-size: 1.1rem;"><i class="fa-solid fa-location-dot me-1"
                                aria-hidden="true"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                    </div>
                    <div id="map" class="listing-map-frame" data-longitude="<%= listing.geometry.coordinates[0] %>"
                        data-latitude="<%= listing.geometry.coordinates[1] %>" data-title="<%= listing.title %>"
                        data-location="<%= listing.location %>, <%= listing.country %>"></div>
                </div>
                <% } %>

        </div>
    </div>
