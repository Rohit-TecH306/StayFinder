<%layout("/layouts/boilerplate")%>
    <div class="listing-form-page">
        <div class="listing-form-shell">
            <div class="mb-3">
                <%- include("../includes/backButton.ejs", { fallback: "/listings/" + listing._id, label: "Back to listing" }) %>
            </div>
            <div class="listing-form-heading">
                <p class="listing-form-eyebrow">Host dashboard</p>
                <h1>Edit listing</h1>
                <p>Keep your listing details accurate for future guests.</p>
            </div>

            <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation listing-form-card" novalidate enctype="multipart/form-data">

                <div class="mb-4">
                    <label for="title" class="form-label">Title</label>
                    <input id="title" type="text" name="title" value="<%= formData.title !== undefined ? formData.title : listing.title %>" class="form-control" required>
                    <div class="invalid-feedback">
                        Please enter a title.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="description" class="form-control" rows="4"
                        required><%= formData.description !== undefined ? formData.description : listing.description %></textarea>
                    <div class="invalid-feedback">
                        Please enter a description.
                    </div>
                </div>


                <div class="mb-4 listing-current-image">
                    <span class="form-label d-block">Current image</span>
                    <img src="<%= originalUrl %>" alt="Current image for <%= listing.title %>" class="img-fluid rounded listing-edit-image">
                </div>

                <div class="mb-4 listing-image-picker">
                    <span class="form-label d-block">Replace Listing Image</span>
                    <p class="form-text mb-2">Use your camera or select a PNG or JPEG image from your device. Leave this blank to keep the current image.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <label for="imageCamera" class="btn btn-outline-dark mb-0">
                            <i class="fa-solid fa-camera" aria-hidden="true"></i> Take Photo
                        </label>
                        <label for="imageBrowser" class="btn btn-outline-dark mb-0">
                            <i class="fa-solid fa-image" aria-hidden="true"></i> Choose Image
                        </label>
                    </div>
                    <input id="imageCamera" type="file" name="image" class="visually-hidden" accept="image/png,image/jpeg" capture="environment" data-listing-image-input>
                    <input id="imageBrowser" type="file" name="image" class="visually-hidden" accept="image/png,image/jpeg" data-listing-image-input>
                    <p class="form-text mb-0" data-image-selection-message aria-live="polite">No replacement image selected.</p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input id="price" type="number" name="price" value="<%= formData.price !== undefined ? formData.price : listing.price %>" min="0" step="1" class="form-control" required>
                        <div class="invalid-feedback">
                            Price should be Valid.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input id="location" type="text" name="location" value="<%= formData.location !== undefined ? formData.location : listing.location %>" class="form-control"
                            required>
                        <div class="invalid-feedback">
                            Location should be Valid.
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="country" class="form-label">Country</label>
                    <input id="country" type="text" name="country" value="<%= formData.country !== undefined ? formData.country : listing.country %>" class="form-control" required>
                    <div class="invalid-feedback">
                        Country Name should be Valid.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="category" class="form-label">Category</label>
                    <select name="category" id="category" class="form-select" required>
                        <% const selectedCategory = formData.category !== undefined ? formData.category : (listing.category || "Iconic Cities"); %>
                        <% listingCategories.forEach(category => { %>
                            <option value="<%= category.value %>" <%= selectedCategory === category.value ? "selected" : "" %>><%= category.label %></option>
                        <% }) %>
                        <% if (!listingCategories.some(category => category.value === selectedCategory)) { %>
                            <optgroup label="Legacy category">
                                <option value="<%= selectedCategory %>" selected><%= selectedCategory %></option>
                            </optgroup>
                        <% } %>
                    </select>
                </div>

                <button class="btn btn-dark edit-btn mt-3 mb-3" type="submit">Edit Listing</button>

            </form>
        </div>
    </div>
