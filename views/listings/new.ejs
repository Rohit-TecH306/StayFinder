<%layout("/layouts/boilerplate")%>

    <div class="listing-form-page">
        <div class="listing-form-shell">
            <div class="mb-3">
                <%- include("../includes/backButton.ejs", { fallback: "/listings", label: "Back to listings" }) %>
            </div>
            <div class="listing-form-heading">
                <p class="listing-form-eyebrow">Host your space</p>
                <h1>Create a listing</h1>
                <p>Share the essentials so guests can find the right stay.</p>
            </div>
            <form method="post" action="/listings" novalidate class="needs-validation listing-form-card" enctype="multipart/form-data">
                <div class="mb-4">
                    <label for="title" class="form-label">Title</label>
                    <input id="title" type="text" name="title" placeholder="Add a Title" value="<%= formData.title || '' %>" class="form-control" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a title.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="description" class="form-control" required><%= formData.description || '' %></textarea>
                    <div class="invalid-feedback">
                        Please enter a description.
                    </div>
                </div>

                <div class="mb-4 listing-image-picker">
                    <span class="form-label d-block">Upload Listing Image</span>
                    <p class="form-text mb-2">Use your camera or select a PNG or JPEG image from your device.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <label for="imageCamera" class="btn btn-outline-dark mb-0">
                            <i class="fa-solid fa-camera" aria-hidden="true"></i> Take Photo
                        </label>
                        <label for="imageBrowser" class="btn btn-outline-dark mb-0">
                            <i class="fa-solid fa-image" aria-hidden="true"></i> Choose Image
                        </label>
                    </div>
                    <input id="imageCamera" type="file" name="image" class="visually-hidden" accept="image/png,image/jpeg" capture="environment" data-listing-image-input>
                    <input id="imageBrowser" type="file" name="image" class="visually-hidden" accept="image/png,image/jpeg" data-listing-image-input>
                    <p class="form-text mb-0" data-image-selection-message aria-live="polite">No image selected.</p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input id="price" type="number" name="price" placeholder="1200" value="<%= formData.price !== undefined ? formData.price : '' %>" min="0" step="1" class="form-control" required>
                        <div class="invalid-feedback">
                            Price Should be Valid.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input id="location" type="text" name="location" placeholder="Udaypur" value="<%= formData.location || '' %>" class="form-control" required>
                        <div class="invalid-feedback">
                            Location Should be Valid.
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="country" class="form-label">Country</label>
                    <input id="country" type="text" name="country" placeholder="India" value="<%= formData.country || '' %>" class="form-control" required>
                    <div class="invalid-feedback">
                        Country Should be Valid.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="category" class="form-label">Category</label>
                    <select name="category" id="category" class="form-select" required>
                        <option value="">Choose a category</option>
                        <% listingCategories.forEach(category => { %>
                            <option value="<%= category.value %>" <%= formData.category === category.value ? 'selected' : '' %>><%= category.label %></option>
                        <% }) %>
                    </select>
                </div>

                <button class="btn btn-dark add-btn mt-3 mb-3" type="submit">Add</button>

            </form>
        </div>
    </div>
