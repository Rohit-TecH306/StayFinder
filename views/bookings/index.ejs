<% layout("/layouts/boilerplate") %>
<main class="bookings-page">
    <div class="bookings-page-shell">
        <div class="mb-3">
            <%- include("../includes/backButton.ejs", { fallback: "/listings", label: "Back to listings" }) %>
        </div>
        <header class="bookings-page-header">
            <h1>My Bookings</h1>
            <p>Track your booking requests and upcoming stays.</p>
        </header>

        <% if (bookings.length === 0) { %>
            <section class="booking-empty-state">
                <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
                <h2>No bookings yet</h2>
                <p>Your requested stays will appear here.</p>
                <a href="/listings" class="btn booking-primary-button">Explore listings</a>
            </section>
        <% } else { %>
            <div class="table-responsive bookings-table-wrap">
                <table class="table bookings-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Property</th>
                            <th scope="col">Check-in</th>
                            <th scope="col">Check-out</th>
                            <th scope="col">Total</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                <% bookings.forEach(booking => { %>
                    <% let statusLabel = "Booking status"; %>
                    <% let statusIcon = "fa-circle-info"; %>
                    <% if (booking.status === "confirmed") { %>
                        <% statusLabel = "Confirmed"; %>
                        <% statusIcon = "fa-circle-check"; %>
                    <% } else if (booking.status === "pending") { %>
                        <% statusLabel = "Awaiting host response"; %>
                        <% statusIcon = "fa-clock"; %>
                    <% } else if (booking.status === "rejected") { %>
                        <% statusLabel = "Rejected"; %>
                        <% statusIcon = "fa-circle-xmark"; %>
                    <% } else if (booking.status === "cancelled") { %>
                        <% statusLabel = "Cancelled"; %>
                        <% statusIcon = "fa-ban"; %>
                    <% } else if (booking.status === "completed") { %>
                        <% statusLabel = "Completed"; %>
                        <% statusIcon = "fa-flag-checkered"; %>
                    <% } %>
                    <tr>
                        <td class="booking-col-property" data-label="Property">
                            <strong class="booking-table-property"><%= booking.listing ? booking.listing.title : "Listing no longer available" %></strong>
                            <% if (booking.listing) { %>
                                <span class="booking-table-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><%= booking.listing.location %>, <%= booking.listing.country %></span>
                            <% } %>
                        </td>
                        <td data-label="Check-in"><%= booking.checkIn.toLocaleDateString("en-IN") %></td>
                        <td data-label="Check-out"><%= booking.checkOut.toLocaleDateString("en-IN") %></td>
                        <td data-label="Total"><strong>₹<%= (booking.totalAmountPaise / 100).toLocaleString("en-IN") %></strong></td>
                        <td data-label="Status"><span class="badge booking-status-badge booking-status-<%= booking.status %>"><i class="fa-solid <%= statusIcon %>" aria-hidden="true"></i><%= statusLabel %></span></td>
                        <td data-label="Action" class="booking-col-action text-lg-end">
                            <a href="/bookings/<%= booking._id %>" class="btn booking-details-button"><span>View details</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</main>
