<% layout("/layouts/boilerplate") %>

<main class="host-requests-page">
    <div class="host-requests-shell">
        <div class="mb-3">
            <%- include("../includes/backButton.ejs", { fallback: "/profile", label: "Back to Profile" }) %>
        </div>
        <header class="host-requests-header">
            <h1>Hosting Requests</h1>
            <p>Review and respond to booking requests for your listings.</p>
        </header>

        <% if (bookings.length === 0) { %>
            <section class="host-requests-empty">
                <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
                <h2>No hosting requests yet</h2>
                <p>Requests for your listings will appear here.</p>
            </section>
        <% } else { %>
            <div class="host-requests-list">
                <% bookings.forEach(booking => { %>
                    <% let statusLabel = "Booking status"; %>
                    <% let statusIcon = "fa-circle-info"; %>
                    <% if (booking.status === "confirmed") { %>
                        <% statusLabel = "Confirmed"; %>
                        <% statusIcon = "fa-circle-check"; %>
                    <% } else if (booking.status === "pending") { %>
                        <% statusLabel = "Awaiting response"; %>
                        <% statusIcon = "fa-clock"; %>
                    <% } else if (booking.status === "rejected") { %>
                        <% statusLabel = "Rejected"; %>
                        <% statusIcon = "fa-circle-xmark"; %>
                    <% } else if (booking.status === "cancelled") { %>
                        <% statusLabel = "Cancelled"; %>
                        <% statusIcon = "fa-ban"; %>
                    <% } else if (booking.status === "completed") { %>
                        <% statusLabel = "Completed"; %>
                        <% statusIcon = "fa-flag-checkered"; %>
                    <% } %>
                    <article class="host-request-record">
                        <header class="host-request-header-row">
                            <div>
                                <p class="host-request-label">Listing</p>
                                <h2><%= booking.listing ? booking.listing.title : "Listing no longer available" %></h2>
                                <p class="host-request-guest"><span>Guest</span><strong><%= booking.guest ? booking.guest.username : "Guest account unavailable" %></strong></p>
                            </div>
                            <span class="badge booking-status-badge booking-status-<%= booking.status %>"><i class="fa-solid <%= statusIcon %>" aria-hidden="true"></i><%= statusLabel %></span>
                        </header>

                        <div class="host-request-grid">
                            <div class="host-request-stay">
                                <p class="host-request-label">Stay</p>
                                <div class="host-request-stay-box">
                                    <strong><%= booking.checkIn.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %> <span aria-hidden="true">→</span> <%= booking.checkOut.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></strong>
                                    <span><%= booking.nights %> night<%= booking.nights === 1 ? "" : "s" %></span>
                                </div>
                            </div>
                            <div class="host-request-total">
                                <p class="host-request-label">Total</p>
                                <strong>₹<%= (booking.totalAmountPaise / 100).toLocaleString("en-IN") %></strong>
                            </div>
                            <div class="host-request-action">
                                <p class="host-request-label">Action</p>
                                <% if (booking.status === "pending") { %>
                                    <div class="host-request-action-buttons">
                                        <form action="/host/bookings/<%= booking._id %>?_method=PATCH" method="POST">
                                            <input type="hidden" name="booking[status]" value="confirmed">
                                            <button class="btn host-confirm-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Confirm</button>
                                        </form>
                                        <form action="/host/bookings/<%= booking._id %>?_method=PATCH" method="POST">
                                            <input type="hidden" name="booking[status]" value="rejected">
                                            <button class="btn host-reject-button"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Reject</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <span class="host-no-action">No action available</span>
                                <% } %>
                            </div>
                        </div>

                        <% if (booking.guestMessage) { %>
                            <div class="host-request-message">
                                <p class="host-request-label"><i class="fa-regular fa-message" aria-hidden="true"></i>Guest message</p>
                                <p><%= booking.guestMessage %></p>
                            </div>
                        <% } %>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</main>
