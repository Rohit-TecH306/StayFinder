<% layout("/layouts/boilerplate") %>
<main class="bookings-page">
    <div class="bookings-page-shell" style="max-width: 48rem;">
        <div class="mb-3">
            <%- include("../includes/backButton.ejs", { fallback: "/profile", label: "Back to Profile" }) %>
        </div>
        <header class="bookings-page-header">
            <p class="bookings-eyebrow">Account Settings</p>
            <h1>Edit Profile</h1>
            <p>Update your personal information or change your password.</p>
        </header>

        <!-- Edit Profile Card -->
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom p-4">
                <h2 class="h5 mb-0 fw-bold text-dark">
                    <i class="fa-regular fa-user me-2 text-danger"></i>Profile Details
                </h2>
            </div>
            <div class="card-body p-4 p-md-5">
                <form action="/profile?_method=PUT" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="username" class="form-label fw-bold">Username</label>
                        <input type="text" name="username" id="username" class="form-control" value="<%= user.username %>" maxlength="100" required autocomplete="username">
                        <div class="invalid-feedback">Please enter a valid username.</div>
                    </div>
                    <div class="mb-4">
                        <label for="email" class="form-label fw-bold">Email Address</label>
                        <input type="email" name="email" id="email" class="form-control" value="<%= user.email %>" maxlength="254" required autocomplete="email">
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Save Changes</button>
                    <a href="/profile" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancel</a>
                </form>
            </div>
        </div>

        <!-- Change Password Card -->
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" id="passwordSection">
            <div class="card-header bg-white border-bottom p-4">
                <h2 class="h5 mb-0 fw-bold text-dark">
                    <i class="fa-solid fa-lock me-2 text-danger"></i>Change Password
                </h2>
            </div>
            <div class="card-body p-4 p-md-5">
                <form action="/profile/password?_method=PUT" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label fw-bold">Current Password</label>
                        <div class="password-field-container">
                            <input type="password" name="currentPassword" id="currentPassword" class="form-control" required autocomplete="current-password">
                            <button type="button" class="password-toggle-btn" aria-label="Show password" data-toggle-password="#currentPassword">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">Please enter your current password.</div>
                    </div>

                    <div class="mb-3">
                        <label for="newPassword" class="form-label fw-bold">New Password</label>
                        <div class="password-field-container">
                            <input type="password" name="newPassword" id="newPassword" class="form-control" minlength="6" required autocomplete="new-password">
                            <button type="button" class="password-toggle-btn" aria-label="Show password" data-toggle-password="#newPassword">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="form-text">Must be at least 6 characters long.</div>
                        <div class="invalid-feedback">New password must be at least 6 characters.</div>
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label fw-bold">Confirm New Password</label>
                        <div class="password-field-container">
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" minlength="6" required autocomplete="new-password">
                            <button type="button" class="password-toggle-btn" aria-label="Show password" data-toggle-password="#confirmPassword">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">Please confirm your new password.</div>
                    </div>

                    <button type="submit" class="btn btn-dark rounded-pill px-4">Update Password</button>
                </form>
            </div>
        </div>
    </div>
</main>
