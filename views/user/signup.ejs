<%layout("/layouts/boilerplate")%>

    <div class="row mt-3">
        <h1 class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">Sign Up for StayFinder</h1>
        <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
            <div class="mb-3">
                <%- include("../includes/backButton.ejs", { fallback: "/listings", label: "Back to listings" }) %>
            </div>
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" id="username" class="form-control"
                        value="<%= typeof username !== 'undefined' ? username : '' %>" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" name="email" id="email" class="form-control"
                        value="<%= typeof email !== 'undefined' ? email : '' %>" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <div class="password-field-container">
                        <input type="password" name="password" id="password" class="form-control" required autocomplete="new-password">
                        <button type="button" class="password-toggle-btn" aria-label="Show password" data-toggle-password="#password">
                            <i class="fa-regular fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <button class="btn btn-success">SignUp</button>
            </form>
        </div>
    </div>
